# Backend settings for LOCAL development (uvicorn on your machine).
# Copy to backend/.env - it is git-ignored. Docker Compose uses the root .env instead.

APP_ENV=development
LOG_LEVEL=INFO

# Dev database container (one line - works in PowerShell, cmd and bash):
#   docker run -d --name medicloud-dev-pg -e POSTGRES_USER=medicloud -e POSTGRES_PASSWORD=devpassword -e POSTGRES_DB=medicloud -p 127.0.0.1:5433:5432 postgres:17-alpine
# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 first and stalls.
DATABASE_URL=postgresql+psycopg://medicloud:devpassword@127.0.0.1:5433/medicloud

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-long-random-value

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=change-me-demo-password
