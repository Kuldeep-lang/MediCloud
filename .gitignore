# ---------- Secrets & local config (never commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
k8s/01-secrets.yaml
k8s/**/secrets.yaml
ansible/inventory.ini
ansible/.vault_pass*
ansible/group_vars/**/vault.yml
!ansible/group_vars/**/vault.yml.example

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/coverage/
npm-debug.log*

# ---------- Terraform ----------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.tfvars
!*.tfvars.example
backend.tf
!backend.tf.example
override.tf
override.tf.json
*_override.tf

# ---------- Reports ----------
trivy-*.json
trivy-*.sarif
reports/

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Terraform: commit the ROOT lock files only (modules are versioned with the root)
terraform/modules/**/.terraform.lock.hcl
