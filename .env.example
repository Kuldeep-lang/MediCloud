# MediCloud environment template (local development and Docker Compose)
# Copy to .env and replace every "change-me" value:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---------- Application ----------
APP_ENV=development
LOG_LEVEL=INFO
ENABLE_DOCS=true
HOSPITAL_TIMEZONE=Asia/Kolkata
CURRENCY=INR

# ---------- PostgreSQL ----------
POSTGRES_DB=medicloud
POSTGRES_USER=medicloud
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Auth ----------
# Generate a strong key:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated origins allowed by CORS (dev tooling; production is same-origin)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Demo data (synthetic only) ----------
SEED_DEMO_DATA=true
# Password for the four seeded demo accounts (admin, doctor, receptionist, pharmacist)
SEED_DEMO_PASSWORD=change-me-demo-password

# ---------- Host port (Docker Compose) ----------
# Only the frontend is published; it proxies /api (and /api/docs) to the backend.
FRONTEND_PORT=8080

# ---------- Monitoring (Compose "monitoring" profile) ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
