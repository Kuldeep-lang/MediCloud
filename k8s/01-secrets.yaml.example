# TEMPLATE ONLY - kubectl ignores this file because it does not end in .yaml.
#
# Create the real (git-ignored) k8s/01-secrets.yaml with strong random values:
#     python scripts/k8s_secrets.py
# or copy this file to k8s/01-secrets.yaml and replace every value by hand.
#
# On EKS the same Secret is created by the CD pipeline from AWS Secrets Manager
# (the RDS-managed password), never from a file in git.
apiVersion: v1
kind: Secret
metadata:
  name: medicloud-secrets
  namespace: medicloud
  labels:
    app.kubernetes.io/part-of: medicloud
type: Opaque
stringData:
  POSTGRES_USER: medicloud
  POSTGRES_PASSWORD: change-me-generate-a-strong-password
  JWT_SECRET_KEY: change-me-at-least-32-random-characters
  SEED_DEMO_PASSWORD: change-me-demo-password
