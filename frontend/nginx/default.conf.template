# MediCloud frontend server. Rendered by envsubst at container start-up:
#   ${BACKEND_UPSTREAM}      e.g. http://backend:8000 (Compose) or the Service FQDN (Kubernetes)
#   ${NGINX_LOCAL_RESOLVERS} the container's DNS server(s), read from /etc/resolv.conf

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Re-resolve the backend name at runtime: nginx starts even if the backend is not up
    # yet, and follows the backend to its new IP when that container is recreated.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers for the web app (inherited by locations without their own add_header).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API: the browser only ever talks to this server.
    location /api/ {
        set $backend ${BACKEND_UPSTREAM};
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        client_max_body_size 2m;
        # JSON responses need no CSP; this also lets Swagger UI (/api/docs) load its assets.
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Fingerprinted build assets never change - cache for a year.
    location /assets/ {
        access_log off;
        expires 1y;
        try_files $uri =404;
    }

    # index.html must always be revalidated so new deployments are picked up.
    location = /index.html {
        expires -1;
    }

    # Single-page app: unknown paths fall back to index.html (client-side routing).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
